Table users {
  id bigint [pk, increment]
  name varchar(255)
  email varchar(255)
  password varchar(255)
  google_id varchar(255)
  avatar text
  email_verified_at timestamp
  role varchar(50)
  status varchar(50)
  booking_locked_until timestamp
  booking_lock_reason text
  remember_token varchar(255)
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table staffs {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  full_name varchar(100)
  phone varchar(20)
  cccd varchar(20)
  birthday date
  gender varchar(20)
  address text
  position varchar(100)
  salary decimal(12,2)
  hire_date date
  avatar text
  work_status varchar(50)
  created_at timestamp
  updated_at timestamp
}

Table customers {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  full_name varchar(255)
  phone varchar(30)
  email varchar(255)
  cccd varchar(30)
  birthday date
  gender varchar(20)
  address text
  status varchar(50)
  created_at timestamp
  updated_at timestamp
}

Table amenities {
  id bigint [pk, increment]
  name varchar(100)
  icon varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table room_categories {
  id bigint [pk, increment]
  name varchar(150)
  base_price decimal(12,2)
  max_capacity int
  bed_count int
  area decimal(8,2)
  status varchar(50)
  description text
  thumbnail varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table room_category_amenities {
  id bigint [pk, increment]
  room_category_id bigint [ref: > room_categories.id]
  amenity_id bigint [ref: > amenities.id]
  created_at timestamp
  updated_at timestamp
}

Table rooms {
  id bigint [pk, increment]
  room_category_id bigint [ref: > room_categories.id]
  room_number varchar(20)
  floor_number int
  status varchar(50)
  note text
  created_at timestamp
  updated_at timestamp
}

Table services {
  id bigint [pk, increment]
  name varchar(100)
  type varchar(50)
  service_group varchar(50)
  price decimal(12,2)
  unit varchar(50)
  billing_rule varchar(50)
  description text
  status varchar(50)
  created_at timestamp
  updated_at timestamp
}

Table bookings {
  id bigint [pk, increment]
  booking_code varchar(30)
  customer_id bigint [ref: > customers.id]
  created_by bigint [ref: > users.id]
  room_category_id bigint [ref: > room_categories.id]
  booking_type varchar(30)
  booking_mode varchar(30)
  booking_source varchar(30)
  check_in_date date
  check_out_date date
  check_in_at timestamp
  check_out_at timestamp
  cleaning_buffer_minutes int
  actual_check_in timestamp
  actual_check_out timestamp
  adult_count int
  child_count int
  baby_count int
  room_quantity int
  prefer_adjacent_rooms bool
  subtotal_amount decimal(12,2)
  discount_amount decimal(12,2)
  estimated_total decimal(12,2)
  final_total decimal(12,2)
  deposit_amount decimal(12,2)
  required_deposit_amount decimal(12,2)
  overpayment_amount decimal(12,2)
  payment_expires_at timestamp
  late_arrival_fee decimal(12,2)
  late_arrival_hours decimal(5,2)
  late_arrival_policy varchar(255)
  payment_status varchar(30)
  status varchar(50)
  note text
  deleted_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table booking_cancellation_requests {
  id bigint [pk, increment]
  booking_id bigint [ref: > bookings.id]
  customer_id bigint [ref: > customers.id]
  requested_by bigint [ref: > users.id]
  status varchar(50)
  reason text
  policy_snapshot text
  requested_at timestamp
  reviewed_by bigint [ref: > users.id]
  reviewed_at timestamp
  review_note text
  created_at timestamp
  updated_at timestamp
}

Table booking_guests {
  id bigint [pk, increment]
  booking_id bigint [ref: > bookings.id]
  booking_room_id bigint [ref: > booking_rooms.id]
  full_name varchar(255)
  guest_type varchar(30)
  document_type varchar(30)
  document_number varchar(50)
  cccd varchar(255)
  birthday date
  gender varchar(20)
  nationality varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table booking_guest_room_histories {
  id bigint [pk, increment]
  booking_id bigint [ref: > bookings.id]
  booking_guest_id bigint [ref: > booking_guests.id]
  room_id bigint [ref: > rooms.id]
  from_time timestamp
  to_time timestamp
  created_at timestamp
  updated_at timestamp
}

Table booking_logs {
  id bigint [pk, increment]
  booking_id bigint [ref: > bookings.id]
  actor_id bigint [ref: > users.id]
  action varchar(255)
  details text
  created_at timestamp
  updated_at timestamp
}

Table booking_payments {
  id bigint [pk, increment]
  booking_id bigint [ref: > bookings.id]
  payment_method varchar(50)
  amount decimal(12,2)
  status varchar(30)
  payment_type varchar(30)
  gateway_reference varchar(255)
  paid_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table booking_promotions {
  id bigint [pk, increment]
  booking_id bigint [ref: > bookings.id]
  promotion_id bigint [ref: > promotions.id]
  scope varchar(30)
  applied_channel varchar(50)
  discount_amount decimal(12,2)
  created_at timestamp
  updated_at timestamp
}

Table booking_promotion_room_upgrades {
  id bigint [pk, increment]
  booking_promotion_id bigint [ref: > booking_promotions.id]
  room_id bigint [ref: > rooms.id]
  old_room_category_id bigint [ref: > room_categories.id]
  new_room_category_id bigint [ref: > room_categories.id]
  created_at timestamp
  updated_at timestamp
}

Table booking_promotion_service_offers {
  id bigint [pk, increment]
  booking_promotion_id bigint [ref: > booking_promotions.id]
  service_id bigint [ref: > services.id]
  amount decimal(12,2)
  created_at timestamp
  updated_at timestamp
}

Table booking_rooms {
  id bigint [pk, increment]
  booking_id bigint [ref: > bookings.id]
  room_id bigint [ref: > rooms.id]
  assigned_at timestamp
  released_at timestamp
  status varchar(50)
  created_at timestamp
  updated_at timestamp
}

Table booking_room_changes {
  id bigint [pk, increment]
  booking_id bigint [ref: > bookings.id]
  old_room_id bigint [ref: > rooms.id]
  new_room_id bigint [ref: > rooms.id]
  change_reason text
  created_at timestamp
  updated_at timestamp
}

Table booking_service_items {
  id bigint [pk, increment]
  booking_id bigint [ref: > bookings.id]
  service_id bigint [ref: > services.id]
  quantity int
  unit_price decimal(12,2)
  amount decimal(12,2)
  scope varchar(30)
  billing_status varchar(30)
  note text
  created_at timestamp
  updated_at timestamp
}

Table booking_staff_assignments {
  id bigint [pk, increment]
  booking_id bigint [ref: > bookings.id]
  staff_id bigint [ref: > staffs.id]
  assignment_type varchar(50)
  assigned_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table cache {
  id bigint [pk, increment]
  key varchar(255)
  value text
  expiration int
}

Table cache_locks {
  id bigint [pk, increment]
  key varchar(255)
  owner varchar(255)
  expiration int
}

Table chat_assignment_logs {
  id bigint [pk, increment]
  conversation_id bigint [ref: > chat_conversations.id]
  staff_id bigint [ref: > staffs.id]
  action varchar(255)
  created_at timestamp
}

Table chat_attachments {
  id bigint [pk, increment]
  conversation_id bigint [ref: > chat_conversations.id]
  message_id bigint [ref: > chat_messages.id]
  file_name varchar(255)
  file_path varchar(255)
  created_at timestamp
}

Table chat_conversations {
  id bigint [pk, increment]
  customer_id bigint [ref: > customers.id]
  staff_id bigint [ref: > staffs.id]
  status varchar(30)
  last_message_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table chat_messages {
  id bigint [pk, increment]
  conversation_id bigint [ref: > chat_conversations.id]
  sender_type varchar(30)
  sender_id bigint
  content text
  created_at timestamp
  updated_at timestamp
}

Table customer_credits {
  id bigint [pk, increment]
  customer_id bigint [ref: > customers.id]
  available_credit decimal(12,2)
  total_credit decimal(12,2)
  updated_at timestamp
}

Table customer_requests {
  id bigint [pk, increment]
  customer_id bigint [ref: > customers.id]
  booking_id bigint [ref: > bookings.id]
  type varchar(50)
  source varchar(50)
  title varchar(255)
  content text
  status varchar(50)
  created_at timestamp
  updated_at timestamp
}

Table customer_request_attachments {
  id bigint [pk, increment]
  customer_request_id bigint [ref: > customer_requests.id]
  file_name varchar(255)
  file_path varchar(255)
  created_at timestamp
}

Table failed_jobs {
  id bigint [pk, increment]
  uuid varchar(255)
  connection text
  queue text
  payload text
  exception text
  failed_at timestamp
}

Table hotel_reviews {
  id bigint [pk, increment]
  customer_id bigint [ref: > customers.id]
  booking_id bigint [ref: > bookings.id]
  rating int
  comment text
  created_at timestamp
  updated_at timestamp
}

Table invoices {
  id bigint [pk, increment]
  booking_id bigint [ref: > bookings.id]
  invoice_code varchar(50)
  total_amount decimal(12,2)
  status varchar(50)
  created_at timestamp
  updated_at timestamp
}

Table jobs {
  id bigint [pk, increment]
  queue varchar(255)
  payload text
  attempts int
  reserved_at int
  available_at int
  created_at int
}

Table job_batches {
  id bigint [pk, increment]
  name varchar(255)
  total_jobs int
  pending_jobs int
  failed_jobs int
  created_at int
  finished_at int
}

Table migrations {
  id int [pk, increment]
  migration varchar(255)
  batch int
}

Table password_reset_tokens {
  id bigint [pk, increment]
  email varchar(255)
  token varchar(255)
  created_at timestamp
}

Table promotions {
  id bigint [pk, increment]
  code varchar(50)
  name varchar(150)
  promotion_type varchar(50)
  discount_type varchar(50)
  discount_value decimal(12,2)
  min_amount decimal(12,2)
  valid_from timestamp
  valid_to timestamp
  status varchar(50)
  created_at timestamp
  updated_at timestamp
}

Table promotion_room_upgrade_offers {
  id bigint [pk, increment]
  promotion_id bigint [ref: > promotions.id]
  room_category_id bigint [ref: > room_categories.id]
  upgrade_price decimal(12,2)
  created_at timestamp
  updated_at timestamp
}

Table promotion_service_offers {
  id bigint [pk, increment]
  promotion_id bigint [ref: > promotions.id]
  service_id bigint [ref: > services.id]
  discount_value decimal(12,2)
  created_at timestamp
  updated_at timestamp
}

Table room_action_logs {
  id bigint [pk, increment]
  room_id bigint [ref: > rooms.id]
  actor_id bigint [ref: > users.id]
  action varchar(255)
  details text
  created_at timestamp
}

Table room_category_images {
  id bigint [pk, increment]
  room_category_id bigint [ref: > room_categories.id]
  image_url varchar(255)
  created_at timestamp
  updated_at timestamp
}

Table room_inspections {
  id bigint [pk, increment]
  room_id bigint [ref: > rooms.id]
  booking_id bigint [ref: > bookings.id]
  status varchar(50)
  workflow_stage varchar(50)
  requested_at timestamp
  completed_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table room_inspection_items {
  id bigint [pk, increment]
  room_inspection_id bigint [ref: > room_inspections.id]
  item_type varchar(50)
  item_name varchar(255)
  status varchar(50)
  guest_response varchar(30)
  note text
  created_at timestamp
  updated_at timestamp
}

Table room_inspection_revisions {
  id bigint [pk, increment]
  room_inspection_id bigint [ref: > room_inspections.id]
  revised_by bigint [ref: > users.id]
  revision_note text
  created_at timestamp
}

Table room_issue_attachments {
  id bigint [pk, increment]
  room_issue_request_id bigint [ref: > room_issue_requests.id]
  file_name varchar(255)
  file_path varchar(255)
  created_at timestamp
}

Table room_issue_requests {
  id bigint [pk, increment]
  room_id bigint [ref: > rooms.id]
  booking_id bigint [ref: > bookings.id]
  customer_id bigint [ref: > customers.id]
  status varchar(50)
  workflow_status varchar(50)
  resolution_type varchar(50)
  proposed_resolution_type varchar(50)
  repair_status varchar(50)
  guest_response varchar(50)
  guest_selected_resolution_type varchar(50)
  issue_description text
  created_at timestamp
  updated_at timestamp
}

Table room_issue_room_holds {
  id bigint [pk, increment]
  room_issue_request_id bigint [ref: > room_issue_requests.id]
  room_id bigint [ref: > rooms.id]
  held_until timestamp
  created_at timestamp
}

Table sessions {
  id bigint [pk, increment]
  user_id bigint [ref: > users.id]
  ip_address varchar(45)
  user_agent text
  payload text
  last_activity int
}

Table staff_floor_assignments {
  id bigint [pk, increment]
  staff_id bigint [ref: > staffs.id]
  floor_number int
  assigned_at timestamp
}

Table staff_room_assignments {
  id bigint [pk, increment]
  staff_id bigint [ref: > staffs.id]
  room_id bigint [ref: > rooms.id]
  assigned_at timestamp
}

Table banned_words {
  id bigint [pk, increment]
  word varchar(255)
  created_by bigint [ref: > users.id]
  created_at timestamp
  updated_at timestamp
}
